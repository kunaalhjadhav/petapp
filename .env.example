# ─────────────────────────────────────────────────────────────
# PetApp environment. Copy to .env and fill in. Never commit .env.
# Values are validated at startup; the API refuses to boot on bad config.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development            # development | test | staging | production
PORT=4000
TRUST_PROXY=0                   # number of proxy hops in front of the API (1 behind a load balancer)
CORS_ORIGINS=http://localhost:3000
SWAGGER_ENABLED=true            # docs at /api/docs (always on outside production)

# ── Data stores ──
DATABASE_URL=postgresql://petapp:petapp@localhost:5432/petapp
SHADOW_DATABASE_URL=postgresql://petapp:petapp@localhost:5432/petapp_shadow
REDIS_URL=redis://localhost:6379
# Managed databases (DigitalOcean, AWS RDS, Azure, Aiven…) sign TLS with their own CA. Download it from the
# provider and paste it here (the PEM text on one line with \n, or the file's base64) so connections are verified;
# then use ?sslmode=require in DATABASE_URL. PowerShell: [Convert]::ToBase64String([IO.File]::ReadAllBytes("ca-certificate.crt"))
DATABASE_CA_CERT=
# The same for a managed Redis/Valkey on rediss:// whose certificate is signed by the provider's own CA
REDIS_CA_CERT=
# E2E tests (never point these at real data)
DATABASE_URL_TEST=postgresql://petapp:petapp@localhost:5432/petapp_test
REDIS_URL_TEST=redis://localhost:6379/15

# ── Auth ── generate secrets with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ISSUER=petapp
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS_APP=30
REFRESH_TTL_HOURS_ADMIN=12
# Reuse of a just-rotated refresh token within this many seconds counts as a parallel refresh, not theft (0 = off)
REFRESH_REUSE_GRACE_SECONDS=15
BCRYPT_ROUNDS=12

# ── OTP ──
OTP_PEPPER=
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_PER_HOUR=5
# With DLT this must match your approved template text exactly. {code} and {minutes} are replaced.
OTP_MESSAGE_TEMPLATE={code} is your PetApp verification code. It is valid for {minutes} minutes. Do not share it with anyone.
DEFAULT_COUNTRY_CODE=91

# ── SMS ── console (dev only, prints the OTP in the API log) | smslocal
SMS_PROVIDER=console
SMSLOCAL_API_URL=
SMSLOCAL_API_KEY=
SMSLOCAL_SENDER_ID=
SMSLOCAL_DLT_TEMPLATE_ID=
SMSLOCAL_DLT_ENTITY_ID=

# ── Email (Phase 9e: staff password resets and notices) ── none | console (dev only, prints emails in the API log) | smtp
EMAIL_PROVIDER=console
SMTP_HOST=
# 587 with STARTTLS (SMTP_SECURE=false), or 465 with TLS (SMTP_SECURE=true)
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=PetApp <no-reply@petapp.in>
# The Admin Dashboard's address, used in password-reset links (https in staging and production)
DASHBOARD_URL=http://localhost:3000
PASSWORD_RESET_TTL_MINUTES=30

# ── Object storage (Phase 2 media) ── S3, Cloudflare R2 or MinIO. Media endpoints return 503 until set.
# These defaults match the MinIO in docker-compose:
S3_ENDPOINT=http://localhost:9000
# Set only if clients reach storage at a different address than the API does (e.g. API inside Docker).
S3_PUBLIC_ENDPOINT=
S3_REGION=ap-south-1
S3_BUCKET=petapp-media
S3_ACCESS_KEY_ID=petapp
S3_SECRET_ACCESS_KEY=petapp-minio-secret
S3_FORCE_PATH_STYLE=true
# Public base URL for the bucket's media/ prefix (a CDN in production). REQUIRED for video playback:
# HLS playlists reference their segments by relative path, which signed URLs can't cover.
# Without it, photos still work through short-lived signed URLs, but videos won't play.
# Local MinIO (docker-compose makes media/ public, uploads/ stays private):
MEDIA_PUBLIC_BASE_URL=http://localhost:9000/petapp-media
UPLOAD_URL_TTL_SECONDS=900
# Worker: parallel media jobs per worker process
MEDIA_CONCURRENCY=2

# ── Payments ── fake (development only: refused in staging/production) | razorpay
PAYMENT_PROVIDER=fake
# Razorpay dashboard → Settings → API Keys / Webhooks.
# Webhook URL: https://<api-host>/api/v1/webhooks/payments  (events: payment.captured, payment.failed, order.paid)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Payouts to sellers, partners and prize winners: fake (development) | razorpayx
PAYOUT_PROVIDER=fake
RAZORPAYX_KEY_ID=
RAZORPAYX_KEY_SECRET=
RAZORPAYX_ACCOUNT_NUMBER=
RAZORPAYX_WEBHOOK_SECRET=
# 32 random bytes, base64: encrypts bank account numbers. Required in staging/production.
# PowerShell 7: [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
PAYOUT_DATA_KEY=
# 32 random bytes, base64 (a different key): encrypts staff two-factor secrets. Required in staging/production.
MFA_DATA_KEY=

# ── AI moderation ── rules (built-in, no network) | anthropic (Claude, Messages API)
# AI only flags content for moderators; nothing is removed automatically. Thresholds are in the dashboard.
AI_PROVIDER=rules
ANTHROPIC_API_KEY=
# Any Messages API model id; a fast, inexpensive model suits moderation.
AI_MODERATION_MODEL=claude-haiku-5-5
AI_TIMEOUT_MS=20000
# PetApp Assistant (Phase 7c): uses the same AI_PROVIDER and key. Turn it on with the ENABLE_AI_ASSISTANT feature switch.
AI_ASSISTANT_MODEL=claude-sonnet-5-5
AI_ASSISTANT_TIMEOUT_MS=30000

# ── Push notifications ── none | console (dev: logs pushes) | fcm
PUSH_PROVIDER=none
# Firebase service account (Project settings → Service accounts → Generate new private key)
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
# Paste the private key on one line with \n for line breaks
FCM_PRIVATE_KEY=
# Worker: parallel notification jobs per worker process
NOTIFY_CONCURRENCY=5

# ── Social sign-in ── comma-separated client IDs (Android, iOS, web)
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=

# ── Seed ── first SUPER_ADMIN (password ≥ 12 chars). Demo data is refused in production.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Super Admin
SEED_DEMO_DATA=false

# ── Observability (Phase 8a) ── see docs/OBSERVABILITY.md
# Logs: JSON lines in staging/production by default; "pretty" for local work.
LOG_FORMAT=
LOG_LEVEL=info
# Error reports: none | sentry (Sentry or a compatible service such as GlitchTip)
ERROR_TRACKER=none
SENTRY_DSN=
# The build being run (e.g. the git commit); set by CI
APP_RELEASE=
# Bearer token for GET /metrics on the API and the worker (worker port below). Required to scrape in staging/production.
METRICS_TOKEN=
WORKER_METRICS_PORT=9464

# ── Public website, apps/web (Phase 8c) ── read by the website only; see apps/web/README.md
# Its public address (canonical links, sitemap, share previews) and the API it reads from (server-side).
SITE_URL=http://localhost:3001
API_URL=http://localhost:4000
# "true" only on the production website; anywhere else, search engines are told to stay out.
SITE_INDEXABLE=false
# Store listings (buttons are hidden until set)
PLAY_STORE_URL=
APP_STORE_URL=
# Shown on /account-deletion for people who can't use the app (app stores require this page)
SUPPORT_EMAIL=
# App links: Android package and signing-key SHA-256 fingerprints (comma-separated); iOS "TEAMID.bundle.id"
ANDROID_PACKAGE_NAME=
ANDROID_SHA256_FINGERPRINTS=
IOS_APP_ID=

# ── Operations (Phase 8d) ── backups, load tests; see docs/DEPLOYMENT.md and load/README.md
# Backups (scripts/ops/backup.mjs): a bucket separate from media, ideally in another account or region.
BACKUP_BUCKET=
BACKUP_PREFIX=postgres/
BACKUP_KEEP_DAYS=35
# 32 random bytes, base64. Keep it in your secret manager, apart from the backups; you need it to restore.
BACKUP_ENCRYPTION_KEY=
# Optional: pinged after each successful backup (alerts you when one is missed)
BACKUP_HEARTBEAT_URL=
# Optional: other credentials for the backup bucket (default: the S3_* settings above)
# BACKUP_S3_ENDPOINT= BACKUP_S3_REGION= BACKUP_S3_ACCESS_KEY_ID= BACKUP_S3_SECRET_ACCESS_KEY= BACKUP_S3_FORCE_PATH_STYLE=
# Load tests on staging only: multiplies every rate limit. Refused in production.
RATE_LIMIT_MULTIPLIER=1

# ── Maps (spec §19) ── none (PetApp's location database only) | google (Geocoding API, India)
# Place search: PIN codes, cities and areas come from PetApp's database first; the map provider adds streets,
# landmarks and areas it doesn't have yet, and names the area at someone's position. Answers are cached for a day.
MAP_PROVIDER=none
# A Google Cloud key with only the Geocoding API enabled; restrict it to the API servers' IP addresses.
GOOGLE_MAPS_KEY=
