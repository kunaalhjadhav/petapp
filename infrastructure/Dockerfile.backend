# syntax=docker/dockerfile:1.7
# PetApp backend — multi-stage build. Build from the repo root:
#   docker build -f infrastructure/Dockerfile.backend -t petapp-backend .

FROM node:26-bookworm-slim AS base
WORKDIR /app
ENV NPM_CONFIG_UPDATE_NOTIFIER=false NPM_CONFIG_FUND=false
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates && rm -rf /var/lib/apt/lists/*

# Install all workspaces (postinstall generates the Prisma client and builds @petapp/types).
FROM base AS deps
COPY package.json package-lock.json tsconfig.base.json prisma.config.ts ./
COPY prisma ./prisma
COPY packages/types ./packages/types
COPY apps/backend/package.json ./apps/backend/package.json
RUN DATABASE_URL=postgresql://build:build@localhost:5432/build npm ci

FROM deps AS build
COPY apps/backend ./apps/backend
RUN npm run build -w @petapp/backend

# One-shot image for `prisma migrate deploy` (keeps the Prisma CLI out of the runtime image).
FROM build AS migrate
CMD ["npx", "prisma", "migrate", "deploy"]

FROM build AS prune
RUN npm prune --omit=dev

FROM node:26-bookworm-slim AS runtime
# The release (git sha), attached to error reports and shown on System health.
ARG APP_RELEASE=
ENV NODE_ENV=production APP_RELEASE=$APP_RELEASE
WORKDIR /app
# FFmpeg is used by the worker (same image, started with `node apps/backend/dist/worker.js`).
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg ca-certificates && rm -rf /var/lib/apt/lists/*
COPY --from=prune --chown=node:node /app/package.json ./
COPY --from=prune --chown=node:node /app/node_modules ./node_modules
COPY --from=prune --chown=node:node /app/packages/types ./packages/types
COPY --from=prune --chown=node:node /app/apps/backend/package.json ./apps/backend/package.json
COPY --from=prune --chown=node:node /app/apps/backend/dist ./apps/backend/dist
USER node
EXPOSE 4000
HEALTHCHECK --interval=15s --timeout=3s --start-period=20s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||4000)+'/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
# API by default; the worker overrides the command.
CMD ["node", "apps/backend/dist/main.js"]
